# ─── Frontend Configuration ───
# URL of the backend API (used in development by Vite proxy)
VITE_BACKEND_URL=http://localhost:3001

# ─── Backend Configuration ───
# The port the NestJS API will listen on
PORT=3001

# Allowed origin for CORS (should match your frontend's URL)
FRONTEND_ORIGIN=http://localhost:3000

# ─── Redis Configuration ───
# Redis host and port for session and leak cache
REDIS_HOST=localhost
REDIS_PORT=6379
